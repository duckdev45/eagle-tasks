# ── 本機開發（pnpm dev）──────────────────────────────────────────────
# 直接打 Apps Script。留空 = Demo 模式（資料存在瀏覽器 localStorage）
VITE_GAS_URL=
# 跟 Apps Script「指令碼屬性」裡的 API_TOKEN 相同
VITE_GAS_TOKEN=

# ── Vercel 正式環境（設在 Vercel → Settings → Environment Variables）──
# VITE_PROXY=1            前端改走 /api/board（CDN 快取，token 不進前端）
# GAS_URL=…/exec          給 api/board.ts 用，不加 VITE_ 前綴
# GAS_TOKEN=…             同上
# NPM_RC=…                安裝 @duckdev45/eagle-component 用
